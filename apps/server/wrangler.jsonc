{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zerochirou-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zerochirou-db",
      "database_id": "b0b805f8-5d90-4cf8-a3d3-5b482a652578",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
